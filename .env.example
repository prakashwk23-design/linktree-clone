# ==========================================================================
# Linktree clone — environment configuration
# Copy this file to ".env" and fill in only the integrations you want.
# Everything is optional: without keys, AI/social/payments fall back to a
# safe demo mode instead of breaking.
# ==========================================================================

# --- App ------------------------------------------------------------------
# Public base URL of your deployment. Used for payment return/webhook URLs
# and OAuth redirect URIs in production. No trailing slash.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI (Ask Linktree chat + Post ideas generator) ------------------------
# Any OpenAI-compatible /chat/completions endpoint works (OpenAI, OpenRouter,
# Groq, Together, Gemini's OpenAI-compatible endpoint, Azure, Ollama…).
# Get a key: https://platform.openai.com/api-keys  (or your provider's console)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY is also accepted as an alias for AI_API_KEY.

# --- Payments: Cashfree (https://dashboard.cashfree.com → Developers → API keys)
# Without these keys the app runs in demo mode in development and refuses
# paid upgrades in production.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox (default) or production
CASHFREE_ENV=sandbox

# --- Social OAuth (Account → Integrations) --------------------------------
# Create an app with each provider, set its redirect/callback URI to
#   {NEXT_PUBLIC_APP_URL}/api/social/<provider>/callback
# then paste the credentials below.

# Instagram (Meta for Developers → Instagram Basic Display / Graph API)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# TikTok (TikTok for Developers → your app)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube (Google Cloud Console → OAuth 2.0 credentials, YouTube Data API v3)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Spotify (Spotify for Developers → your app)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# X / Twitter (X Developer Portal → your app, OAuth 2.0 + PKCE)
X_CLIENT_ID=
X_CLIENT_SECRET=
